{
    "name": "garak/buraco",
    "type": "library",
    "description": "A PHP library to manage buraco/burraco card games",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Massimiliano Arione",
            "email": "garakkio@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/collections": "^2.0 || ^3.0",
        "garak/card": "^0.12",
        "symfony/polyfill-php84": "^1.38",
        "symfony/polyfill-php85": "^1.41"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.3"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Garak\\Buraco\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Garak\\Buraco\\Test\\": "tests"
        }
    }
}
